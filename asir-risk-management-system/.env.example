# ============================================================
# Asir Health Cluster ERMS - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_USER=erms_user
DB_PASSWORD=change_me_strong_password
DB_NAME=asir_erms
DB_SSL=false

# --- Backend server ---
NODE_ENV=production
PORT=4000
CORS_ORIGIN=http://localhost:8080

# --- JWT auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace_with_random_64_char_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_hex_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- File uploads ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=15

# --- AI provider: choose ONE of claude | openai | gemini | ollama | none ---
AI_PROVIDER=none

# Anthropic Claude (https://console.anthropic.com)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_BASE_URL=https://api.anthropic.com/v1/messages

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Google Gemini / Google Cloud (https://aistudio.google.com or Vertex AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Local Llama via Ollama (self-hosted, no API key / fully offline)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/api/generate
